    <diagram id="xLqrz8g5pz-5__JnOkiu" name="Compliance">
        <mxGraphModel dx="2370" dy="1665" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor User as Content Creator\n    participant FE as Frontend UI (Compliance Page)\n    participant API as FastAPI Router (routes/compliance.py)\n    participant S3 as AWS S3 Storage\n    participant DB as Supabase DB\n    participant LG as LangGraph Pipeline (compliance_pipeline.py)\n    participant GEM as Google Gemini 2.5 Flash\n\n    %% ─── Upload &amp; Trigger ───────────────────────────────────────────\n    User-&gt;&gt;FE: Upload media + select market/ethnicity/age_group/platform\n    FE-&gt;&gt;API: POST /api/compliance/check {file, market, target_ethnicity, age_group, platform}\n    Note right of API: Response is SSE stream (text/event-stream)\n\n    API-&gt;&gt;DB: Create project (if needed)\n    API-&gt;&gt;DB: Create task record (status=\&quot;pending\&quot;)\n    Note right of DB: tasks table → returns task_id\n\n    API-&gt;&gt;S3: Upload original media file\n    S3--&gt;&gt;API: Return s3_upload_key (public URL)\n\n    API--&gt;&gt;FE: SSE Event \&quot;initiated\&quot; {task_id, media_type, s3_upload_key}\n\n    %% ─── Pipeline Execution (streamed via SSE) ─────────────────────\n    Note over API,LG: Pipeline runs synchronously within SSE stream\n\n    API--&gt;&gt;FE: SSE Event \&quot;node_status\&quot; {node: \&quot;fetch_rules_and_personas\&quot;, status: \&quot;running\&quot;}\n    API-&gt;&gt;DB: Query ad_policy_rules table (filter by market + platform)\n    DB--&gt;&gt;API: Return regulatory rules (JSON array)\n    API-&gt;&gt;DB: Query personas table (filter by market + ethnicity + age_group)\n    DB--&gt;&gt;API: Return persona data (JSONB)\n    API-&gt;&gt;DB: Insert pipeline_progress (step=\&quot;fetch_rules_and_personas\&quot;, status=\&quot;completed\&quot;)\n    API--&gt;&gt;FE: SSE Event \&quot;node_status\&quot; {node: \&quot;fetch_rules_and_personas\&quot;, status: \&quot;completed\&quot;}\n\n    %% ─── Conditional: Audio/Video Transcription ─────────────────────\n    alt media_type is audio or video\n        API--&gt;&gt;FE: SSE Event \&quot;node_status\&quot; {node: \&quot;transcribe_media\&quot;, status: \&quot;running\&quot;}\n        API-&gt;&gt;GEM: Send media bytes + transcription prompt\n        GEM--&gt;&gt;API: Return {language, transcript} JSON\n        API-&gt;&gt;DB: Insert pipeline_progress (step=\&quot;transcribe_media\&quot;, status=\&quot;completed\&quot;)\n        API--&gt;&gt;FE: SSE Event \&quot;node_status\&quot; {node: \&quot;transcribe_media\&quot;, status: \&quot;completed\&quot;}\n    end\n\n    %% ─── Main Compliance Analysis ───────────────────────────────────\n    API--&gt;&gt;FE: SSE Event \&quot;node_status\&quot; {node: \&quot;main_brain_analysis\&quot;, status: \&quot;running\&quot;}\n    API-&gt;&gt;DB: Fetch business_profiles (via project → owner_email)\n    DB--&gt;&gt;API: Return business context\n\n    alt media_type is image or video\n        API-&gt;&gt;GEM: Pre-scan: describe media content (multimodal)\n        GEM--&gt;&gt;API: Return visual description\n    end\n\n    API-&gt;&gt;GEM: Full compliance analysis (media + rules + persona + business context)\n    Note right of GEM: Structured JSON output with&lt;br/&gt;risk_percentage, risk_level,&lt;br/&gt;high_risk_indicators, suggestion,&lt;br/&gt;localization_plan\n    GEM--&gt;&gt;API: Return compliance analysis JSON\n    API-&gt;&gt;DB: Insert pipeline_progress (step=\&quot;main_brain_analysis\&quot;, status=\&quot;completed\&quot;)\n    API--&gt;&gt;FE: SSE Event \&quot;node_status\&quot; {node: \&quot;main_brain_analysis\&quot;, status: \&quot;completed\&quot;}\n\n    %% ─── Judges Agent (Bias Check) ─────────────────────────────────\n    API--&gt;&gt;FE: SSE Event \&quot;node_status\&quot; {node: \&quot;judges_agent\&quot;, status: \&quot;running\&quot;}\n    API-&gt;&gt;GEM: Evaluate for bias/hallucination (analysis + rules + persona)\n    GEM--&gt;&gt;API: Return {overall_pass, hallucination_score, evaluation}\n    API-&gt;&gt;DB: Insert pipeline_progress (step=\&quot;judges_agent\&quot;, status=\&quot;completed\&quot;)\n    API--&gt;&gt;FE: SSE Event \&quot;node_status\&quot; {node: \&quot;judges_agent\&quot;, status: \&quot;completed\&quot;}\n\n    %% ─── Decision Router ────────────────────────────────────────────\n    API--&gt;&gt;FE: SSE Event \&quot;node_status\&quot; {node: \&quot;decision_router\&quot;, status: \&quot;running\&quot;}\n    API-&gt;&gt;LG: route_compliance_decision(risk_level, risk_percentage, indicators)\n    Note right of LG: Outcome: \&quot;pass\&quot; | \&quot;critical_regen\&quot; | \&quot;remediate\&quot;\n\n    API-&gt;&gt;DB: Update compliance_checks (status, risk_percentage, result_json)\n    API-&gt;&gt;DB: Insert pipeline_progress (step=\&quot;decision_router\&quot;, status=\&quot;completed\&quot;)\n    API--&gt;&gt;FE: SSE Event \&quot;node_status\&quot; {node: \&quot;decision_router\&quot;, status: \&quot;completed\&quot;}\n\n    %% ─── Result Delivery ────────────────────────────────────────────\n    API-&gt;&gt;S3: Upload segmented mask (if image with violations)\n    S3--&gt;&gt;API: Return s3_segmented_key\n    API-&gt;&gt;DB: Insert compliance_checks record (task_id, result_json, s3 keys)\n    API-&gt;&gt;DB: Update task status → \&quot;checked\&quot;\n\n    API--&gt;&gt;FE: SSE Event \&quot;result\&quot; {data: {task_id, risk_percentage, violations, ...}}\n    Note right of FE: SSE stream closes automatically\n    FE--&gt;&gt;User: Display compliance result (risk score, violations, suggestions)\n\n    %% ─── Optional: Remediation (separate trigger) ───────────────────\n    opt User requests remediation\n        User-&gt;&gt;FE: Click \&quot;Fix Issues\&quot; button\n        FE-&gt;&gt;API: POST /api/compliance/{task_id}/remediate\n        Note over API: Spawns Remediation Pipeline (Pipeline 2)\n    end&quot;,&#10;  &quot;config&quot;: null&#10;}" id="JijmvMF57RCgsxL3XSae-1">
                    <mxCell style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" parent="1" connectable="0" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="Content Creator" mermaidId="n:User" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Content Creator" id="JijmvMF57RCgsxL3XSae-2">
                    <mxCell style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" parent="JijmvMF57RCgsxL3XSae-1" vertex="1">
                        <mxGeometry x="40" y="40" width="150" height="2720" as="geometry"/>
