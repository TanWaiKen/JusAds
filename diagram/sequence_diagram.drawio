    <diagram name="VidGen" id="vvJhEyi71JGlgmzKXt_r">
        <mxGraphModel dx="1580" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Creator as Content Creator\n    participant FE as Frontend UI (StoryboardCanvas)\n    participant API as FastAPI Router (routes/generation.py)\n    participant DIR as Gemini Director Agent\n    participant IMG as Vertex AI (Imagen 4.0)\n    participant VEO as Vertex AI (Veo 3.1 Lite)\n    participant S3 as AWS S3 Storage\n    participant ASM as FFmpeg Assembler (backend/utils/ffmpeg.py)\n    participant DB as Supabase DB\n\n    Creator-&gt;&gt;FE: Input prompt and toggle \&quot;Video V2 Multi-Scene\&quot;\n    FE-&gt;&gt;API: POST /api/generate/video {prompt, video_v2: true}\n    API-&gt;&gt;DB: Create task record (status=\&quot;planning\&quot;)\n    API-&gt;&gt;DIR: Plan script (prompt, target_ethnicity)\n    DIR--&gt;&gt;API: Return storyboard JSON {scenes: [1,2,3], character_turnaround, audio_scripts}\n    API--&gt;&gt;FE: SSE Event \&quot;planned\&quot; (Render storyboard cards on Frontend)\n    \n    par Generate Turnaround Sheet\n        API-&gt;&gt;IMG: Generate Character Sheet (3-view prompt)\n        IMG--&gt;&gt;API: Return character_sheet_bytes\n    and Generate Scene Grid\n        API-&gt;&gt;IMG: Generate Scene Grid (NxM keyframes layout)\n        IMG--&gt;&gt;API: Return scene_grid_bytes\n    end\n    \n    API-&gt;&gt;API: Slice grid into individual scene keyframes (PIL)\n    \n    loop For each scene clip (1 to N)\n        API-&gt;&gt;VEO: Image-to-Video generation (keyframe_start, keyframe_end)\n        VEO--&gt;&gt;API: Return scene_clip.mp4 bytes\n    end\n\n    API-&gt;&gt;ASM: Stitch clips &amp; overlay voiceover (ElevenLabs) + subtitles\n    ASM--&gt;&gt;API: Assembled final_video.mp4 &amp; CapCut draft\n    API-&gt;&gt;S3: Upload final_video.mp4 &amp; capcut_draft.json\n    API-&gt;&gt;DB: Save generated_ads record &amp; update task status=\&quot;done\&quot;\n    API--&gt;&gt;FE: SSE Event \&quot;completed\&quot; {ad_id, video_url, capcut_draft_url}\n    FE--&gt;&gt;Creator: Render final video preview and offer CapCut export download\n&quot;,&#10;  &quot;config&quot;: null&#10;}" id="yBhxGVW-iHkDkOMy_Hya-1">
