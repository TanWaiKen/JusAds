    <diagram name="ComplianceChecker" id="compliance-seq-diagram">
        <mxGraphModel dx="3160" dy="2220" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor User as Content Creator\n    participant FE as Frontend UI\n    participant API as FastAPI (routes/compliance.py)\n    participant S3 as AWS S3\n    participant DB as Supabase DB\n    participant GEM as Gemini 2.5 Flash\n\n    User-&gt;&gt;FE: Upload media + select market/ethnicity/age_group/platform\n    FE-&gt;&gt;API: POST /api/compliance/check {file, market, target_ethnicity, age_group, platform}\n    Note right of API: Response is SSE stream\n\n    API-&gt;&gt;DB: Create task (status=\&quot;pending\&quot;)\n    API-&gt;&gt;S3: Upload original media\n    S3--&gt;&gt;API: s3_upload_key\n    API--&gt;&gt;FE: SSE \&quot;initiated\&quot; {task_id, media_type}\n\n    API-&gt;&gt;DB: Fetch ad_policy_rules (market + platform)\n    API-&gt;&gt;DB: Fetch personas (market + ethnicity + age_group)\n    API--&gt;&gt;FE: SSE \&quot;node_status\&quot; {fetch_rules: completed}\n\n    alt audio/video\n        API-&gt;&gt;GEM: Transcribe media\n        GEM--&gt;&gt;API: {language, transcript}\n        API--&gt;&gt;FE: SSE \&quot;node_status\&quot; {transcribe: completed}\n    end\n\n    API-&gt;&gt;GEM: Compliance analysis (media + rules + persona)\n    GEM--&gt;&gt;API: {risk_percentage, violations, suggestion}\n    API--&gt;&gt;FE: SSE \&quot;node_status\&quot; {analysis: completed}\n\n    API-&gt;&gt;GEM: Bias/hallucination check\n    GEM--&gt;&gt;API: {pass, score}\n    API--&gt;&gt;FE: SSE \&quot;node_status\&quot; {judges: completed}\n\n    API-&gt;&gt;API: Decision: pass | critical_regen | remediate\n    API-&gt;&gt;DB: Save compliance_checks result\n    API--&gt;&gt;FE: SSE \&quot;result\&quot; {task_id, risk_percentage, violations}\n    FE--&gt;&gt;User: Display compliance result\n&quot;,&#10;  &quot;config&quot;: null&#10;}" id="comp-mermaid-1">
                    <mxCell style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" parent="1" connectable="0" vertex="1">
                        <mxGeometry width="1000" height="1000" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor User as Content Creator\n    participant FE as Frontend UI\n    participant API as FastAPI (routes/compliance.py)\n    participant S3 as AWS S3\n    participant DB as Supabase DB\n    participant GEM as Gemini 2.5 Flash\n\n    User-&gt;&gt;FE: Upload media + select market/ethnicity/age_group/platform\n    FE-&gt;&gt;API: POST /api/compliance/check {file, market, target_ethnicity, age_group, platform}\n    Note right of API: Response is SSE stream\n\n    API-&gt;&gt;DB: Create task (status=\&quot;pending\&quot;)\n    API-&gt;&gt;S3: Upload original media\n    S3--&gt;&gt;API: s3_upload_key\n    API--&gt;&gt;FE: SSE \&quot;initiated\&quot; {task_id, media_type}\n\n    API-&gt;&gt;DB: Fetch ad_policy_rules (market + platform)\n    API-&gt;&gt;DB: Fetch personas (market + ethnicity + age_group)\n    API--&gt;&gt;FE: SSE \&quot;node_status\&quot; {fetch_rules: completed}\n\n    alt audio/video\n        API-&gt;&gt;GEM: Transcribe media\n        GEM--&gt;&gt;API: {language, transcript}\n        API--&gt;&gt;FE: SSE \&quot;node_status\&quot; {transcribe: completed}\n    end\n\n    API-&gt;&gt;GEM: Compliance analysis (media + rules + persona)\n    GEM--&gt;&gt;API: {risk_percentage, violations, suggestion}\n    API--&gt;&gt;FE: SSE \&quot;node_status\&quot; {analysis: completed}\n\n    API-&gt;&gt;GEM: Bias/hallucination check\n    GEM--&gt;&gt;API: {pass, score}\n    API--&gt;&gt;FE: SSE \&quot;node_status\&quot; {judges: completed}\n\n    API-&gt;&gt;API: Decision: pass | critical_regen | remediate\n    API-&gt;&gt;DB: Save compliance_checks result\n    API--&gt;&gt;FE: SSE \&quot;result\&quot; {task_id, risk_percentage, violations}\n    FE--&gt;&gt;User: Display compliance result&quot;,&#10;  &quot;config&quot;: {&#10;    &quot;theme&quot;: &quot;neutral&quot;,&#10;    &quot;arrowMarkerAbsolute&quot;: false,&#10;    &quot;flowchart&quot;: {&#10;      &quot;htmlLabels&quot;: false&#10;    },&#10;    &quot;sequence&quot;: {&#10;      &quot;diagramMarginX&quot;: 50,&#10;      &quot;diagramMarginY&quot;: 10,&#10;      &quot;actorMargin&quot;: 50,&#10;      &quot;width&quot;: 150,&#10;      &quot;height&quot;: 65,&#10;      &quot;boxMargin&quot;: 10,&#10;      &quot;boxTextMargin&quot;: 5,&#10;      &quot;noteMargin&quot;: 10,&#10;      &quot;messageMargin&quot;: 35,&#10;      &quot;mirrorActors&quot;: true,&#10;      &quot;bottomMarginAdj&quot;: 1,&#10;      &quot;useMaxWidth&quot;: true,&#10;      &quot;rightAngles&quot;: false,&#10;      &quot;showSequenceNumbers&quot;: false&#10;    },&#10;    &quot;gantt&quot;: {&#10;      &quot;titleTopMargin&quot;: 25,&#10;      &quot;barHeight&quot;: 20,&#10;      &quot;barGap&quot;: 4,&#10;      &quot;topPadding&quot;: 50,&#10;      &quot;leftPadding&quot;: 75,&#10;      &quot;gridLineStartPadding&quot;: 35,&#10;      &quot;fontSize&quot;: 11,&#10;      &quot;fontFamily&quot;: &quot;\&quot;Open-Sans\&quot;, \&quot;sans-serif\&quot;&quot;,&#10;      &quot;numberSectionStyles&quot;: 4,&#10;      &quot;axisFormat&quot;: &quot;%Y-%m-%d&quot;&#10;    }&#10;  }&#10;}" id="M9VuPAVOD_dPt-qSsxp2-1">
