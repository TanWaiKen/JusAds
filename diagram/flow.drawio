                <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;graph TD\n    %% Styling\n    classDef input fill:#d4e1f5,stroke:#1e4620,stroke-width:2px;\n    classDef process fill:#e2f0d9,stroke:#385723,stroke-width:2px;\n    classDef output fill:#fce4d6,stroke:#c65911,stroke-width:2px;\n    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px;\n\n    subgraph PIPELINE_1 [Pipeline 1: Compliance Checker Engine]\n        In_Comp[\&quot;INPUT:&lt;br&gt;• Media Payload (Video/Img/Aud/Txt)&lt;br&gt;• Target Demographics (Nation/Ethnic/Age)&lt;br&gt;• Platform (TikTok, Meta, Shopee, etc.)&lt;br&gt;• User Prompt Context\&quot;] --&gt; Node_Supa1[\&quot;PROCESS: DB Lookup&lt;br&gt;• Fetch specific Regulatory Rules &amp; Personas from Supabase\&quot;]\n        Node_Supa1 --&gt; Node_Trans[\&quot;PROCESS: Multimodal Transcription&lt;br&gt;• Extract Text Copy&lt;br&gt;• Generate Audio &amp; Video Transcripts via Gemini\&quot;]\n        \n        Node_Trans --&gt; Node_Brain[\&quot;PROCESS: Main Brain Analysis&lt;br&gt;• Cross-reference text/transcripts against .md rules&lt;br&gt;• Execute search tools for localized context updates\&quot;]\n        \n        Node_Brain --&gt; Node_Judge[\&quot;PROCESS: Judges Agent Gate&lt;br&gt;• Independent internal evaluation loop&lt;br&gt;• Blind check for Bias &amp; Hallucinations (No Search)\&quot;]\n        \n        Node_Judge --&gt; Out_Comp[\&quot;OUTPUT: Compliance Audit Payload&lt;br&gt;• Status, Risk Level &amp; Percentage&lt;br&gt;• High-Risk Indicators &amp; Violated Timestamps&lt;br&gt;• Remediation Markdown (.md) Instruction File\&quot;]\n        \n        Out_Comp --&gt; Node_DB_Write[\&quot;PROCESS: State Sync&lt;br&gt;• Update Supabase with compliance status &amp; logs\&quot;]\n    end\n\n    subgraph ROUTING_GATE [LangGraph Router Logic]\n        Node_DB_Write --&gt; Conditional_Gate{\&quot;Decision Gate:&lt;br&gt;Status == PASS?\&quot;}\n        Conditional_Gate -- \&quot;Yes (Pass)\&quot; --&gt; End_Green[\&quot;TERMINATE:&lt;br&gt;Return 200 OK / Ready to Publish\&quot;]\n        Conditional_Gate -- \&quot;No (Critical Failure)\&quot; --&gt; End_Red[\&quot;TRIGGER REGEN:&lt;br&gt;Discard Asset &amp; Request New Poster/Script Generation\&quot;]\n        Conditional_Gate -- \&quot;No (Fixable Risks)\&quot; --&gt; Link_Remediate[\&quot;ROUTE TO REMEDIATION PIPELINE\&quot;]\n    end\n\n    subgraph PIPELINE_2 [Pipeline 2: Remediate &amp; Remix Engine]\n        Link_Remediate --&gt; In_Remed[\&quot;INPUT:&lt;br&gt;• Original Source Media Assets&lt;br&gt;• Compliance .md Audit Instructions&lt;br&gt;• Supabase Target Audience Data\&quot;]\n        \n        In_Remed --&gt; Node_User_Conf[\&quot;PROCESS: User Verification Gate&lt;br&gt;• Confirm target delivery aspect ratios (9:16, 16:9, 1:1)&lt;br&gt;• Lock layout strategy options based on platform database rules\&quot;]\n        \n        Node_User_Conf --&gt; Node_Strategy[\&quot;PROCESS: Editing Strategy Parser&lt;br&gt;• Split remediation instructions into modal execution tasks\&quot;]\n        \n        %% Parallel Asset Re-generation\n        Node_Strategy --&gt; Node_Img_Fix[\&quot;PROCESS: Image Sculpting Mod&lt;br&gt;• Reference original image &amp; mask regions&lt;br&gt;• Apply inpainting to correct localized assets\&quot;]\n        Node_Strategy --&gt; Node_Vid_Fix[\&quot;PROCESS: Video Morphing Mod&lt;br&gt;• Extract keyframes &amp; apply prompt guidance&lt;br&gt;• Generate corrected I2V cuts using frame consistency\&quot;]\n        Node_Strategy --&gt; Node_Txt_Fix[\&quot;PROCESS: Text Generation Mod&lt;br&gt;• Re-write text copy for compliant messaging\&quot;]\n        Node_Strategy --&gt; Node_Aud_Fix[\&quot;PROCESS: Audio Recreation Mod&lt;br&gt;• Generate brand new clean voiceover TTS&lt;br&gt;• Re-mix compliant local background music\&quot;]\n        \n        Node_Img_Fix --&gt; Node_Compile[\&quot;PROCESS: Final Asset Convergence&lt;br&gt;• Stitches updated elements together via FFmpeg compilation\&quot;]\n        Node_Vid_Fix --&gt; Node_Compile\n        Node_Txt_Fix --&gt; Node_Compile\n        Node_Aud_Fix --&gt; Node_Compile\n        \n        Node_Compile --&gt; Out_Remed[\&quot;OUTPUT:&lt;br&gt;• Remediated Multi-Platform Media URLs&lt;br&gt;• Updated Database Entry Profile\&quot;]\n    end\n\n    %% Apply Styles\n    class In_Comp,In_Remed input;\n    class Node_Supa1,Node_Trans,Node_Brain,Node_Judge,Node_DB_Write,Node_User_Conf,Node_Strategy,Node_Img_Fix,Node_Vid_Fix,Node_Txt_Fix,Node_Aud_Fix,Node_Compile process;\n    class Out_Comp,Out_Remed,End_Green,End_Red output;&quot;,&#10;  &quot;config&quot;: null&#10;}" id="3">
